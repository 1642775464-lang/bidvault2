# ONLYOFFICE Document Server（阶段二）
# 浏览器加载编辑器的地址（docker compose 默认映射 8080）
ONLYOFFICE_DOCUMENT_SERVER_PUBLIC_URL=http://localhost:8080
# Document Server 容器回调/拉取文件用的本服务地址（容器内不能写 127.0.0.1）
ONLYOFFICE_BACKEND_INTERNAL_URL=http://host.docker.internal:8000
# 两端共享的 JWT 密钥（须与 docker-compose 的 JWT_SECRET 一致）
ONLYOFFICE_JWT_SECRET=bidvault-onlyoffice-dev-secret
