  "cards": [
    {
      "dot": "cyan",
      "title": "主数据路径",
      "items": [
        "来源→入库→拆解→沉淀→复用：五个阶段从左到右，粗线是主链",
        "文档库是中央枢纽：一切文件先落库，再拆解出结构化数据",
        "素材库与检索索引是两条并行沉淀线，最终都汇入工作台"
      ]
    },
    {
      "dot": "emerald",
      "title": "关键去重与闭环",
      "items": [
        "入库去重：路径+mtime+size，文件变化才重新入库",
        "素材去重：来源文档+标题相同不重复入库",
        "拆解状态回写：未拆解→拆解中→已拆解，驱动前端展示"
      ]
    },
    {
      "dot": "rose",
      "title": "数据安全",
      "items": [
        "全部数据在本机 data/ 目录，不出域",
        "涉密判断发生在拆解抽取前：涉密走本地、非涉密才可调云端 AI",
        "导出是唯一出口：Word/Excel/PDF，导出前有致命项拦截确认"
      ]
    }
  ]
