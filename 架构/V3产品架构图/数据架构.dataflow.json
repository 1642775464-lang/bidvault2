  "cards": [
    { "dot": "emerald", "title": "主数据链路（从左到右一条线）", "items": ["文件 → documents → extractions → materials → material_references → office_documents → 工作区 DOCX", "每一跳都有字段级凭证：file_hash 去重、quote 原文定位、锚点 hash 定位章节", "工作区里的 DOCX 是投影副本，数据库版本链才是唯一真源"] },
    { "dot": "cyan", "title": "规则与历史（拆解规则中心）", "items": ["当前规则负责未来拆解；Execution Snapshot（执行档案）负责解释过去——快照是唯一真源", "documents 表带溯源两列：这条文档当时用哪个规则版本、哪个规则哈希拆出来的", "改规则不会改历史结果，新旧文档可对比、可重算"] },
    { "dot": "rose", "title": "一致性与安全红线", "items": ["引用三态：正常 / 漂移 / 丢失——正文被外部编辑后系统能自查引用是否还有效", "插入有三道闸（版本、锚点、分节符边界），拒绝时不静默回退", "AI 提案必须人工确认才写版本；投影写回先记数据库再动文件，崩溃可恢复", "chunks 双索引支撑秒级检索；check_items 逐条四态结论可回跳原文页码"] }
  ]
